# ============================================================
# ResolveAI Backend — Environment Variables
# Platform: Render (backend) + Neon (PostgreSQL)
# ============================================================
# Copy this file to .env for local development ONLY.
# NEVER commit .env to git.
# In production, add these as Environment Variables in Render dashboard.

# -- Application --
APP_ENV=production
DEBUG=false
# APP_DEBUG mirrors DEBUG for compatibility
APP_DEBUG=false

# -- Neon PostgreSQL (Render + Neon) --
# Paste the full connection string from Neon dashboard → Connection Details → Connection string
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# SSL is REQUIRED for Neon
DB_SSLMODE=require
DB_CONNECTION=pgsql

# -- JWT --
# Generate: openssl rand -base64 48  OR use https://generate-secret.vercel.app/64
JWT_SECRET=

# -- AI (Optional — app works without these) --
GEMINI_API_KEY=
OPENAI_API_KEY=

# -- CORS (set to your Vercel frontend URL after deploying) --
# Example: https://resolve-ai-abc123.vercel.app
FRONTEND_URL=

# -- Port (Render injects this automatically — do NOT set manually on Render) --
# PORT=10000
