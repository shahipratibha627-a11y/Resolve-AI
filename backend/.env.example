# ResolveAI Backend Environment Configuration
# For local development with SQLite, no variables are required (zero-config).
# When deploying to Railway with PostgreSQL, configure the following:

# Dynamic Port (Railway injects PORT automatically)
PORT=5000

# Railway Database Connection
# Option A: Full Railway URL (recommended for Railway deployment)
DATABASE_URL=postgresql://postgres:password@host:5432/railway

# Option B: Individual database parameters (or PGHOST, PGPORT, etc.)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=resolveai
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_SSLMODE=prefer

# Security & JWT Token
JWT_SECRET=resolveai_super_secure_jwt_token_key_2026_x89f_engine

# AI Providers (Optional LLM inference, full local NLP fallback included)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Application Settings
APP_DEBUG=true

