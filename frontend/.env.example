# ResolveAI Frontend Environment Configuration
# For local development with Vite proxy, leave empty or '/api' (defaults to http://localhost:5000)
# VITE_API_BASE_URL=/api

# For production deployment on Vercel:
# Set this environment variable in your Vercel Project Settings -> Environment Variables.
# Replace with your deployed Railway PHP backend domain:
VITE_API_BASE_URL=https://your-railway-backend.up.railway.app/api
